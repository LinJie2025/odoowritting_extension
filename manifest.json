{
  "manifest_version": 3,
  "name": "Odoo Excel Importer",
  "version": "1.10.0",
  "description": "Import Excel data into Odoo RFQ order lines",
  "icons": {
    "16": "icons/odoo-icon.png",
    "48": "icons/odoo-icon.png",
    "128": "icons/odoo-icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/xlsx.full.min.js", "lib/pdf.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js", "lib/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
